{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnel.dev/schemas/mnel-training-shard.schema.json",
  "title": "MNEL identified training shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shard_identity", "dataset_identity", "shard_index", "shard_count", "source_record_ids", "provider_family", "feature_extractor_identity", "training_code_identity", "visibility", "authority", "semantics"],
  "properties": {
    "schema": {"const": "mnel-training-shard/0.5"},
    "shard_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partition_method": {"type": "string", "minLength": 1},
    "partition_seed": {"type": "integer", "minimum": 0},
    "shard_index": {"type": "integer", "minimum": 0},
    "shard_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "source_record_ids": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}},
    "provider_family": {"type": "string", "minLength": 1},
    "feature_extractor_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "training_code_identity": {"type": "string", "minLength": 1},
    "visibility": {"const": "development-visible"},
    "authority": {"const": "diagnostic-only"},
    "semantics": {"const": "identified-training-shard; not-a-verdict"}
  }
}
