{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnel.example/schemas/learned-provider-registry.schema.json",
  "title": "MNEL learned micro-provider records",
  "oneOf": [
    {"$ref": "#/$defs/declaration"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/query"}
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "outputKind": {
      "enum": [
        "latent-discrepancy",
        "structural-discrepancy",
        "anomaly-score",
        "pair-similarity",
        "next-state-distribution",
        "feature-contributions",
        "candidate-ranking"
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "target", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "target": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_id",
        "version",
        "architecture_family",
        "architecture_name",
        "objective_family",
        "purpose",
        "rationale",
        "training_objective",
        "input_views",
        "artifact_types",
        "uncertainty_classes",
        "output_kinds",
        "required_snapshot_types",
        "advantages",
        "limitations",
        "capacity",
        "cost",
        "cpu_appropriate",
        "calibration_required",
        "evaluator_eligible",
        "authority",
        "declaration_identity"
      ],
      "properties": {
        "schema": {"const": "mnel-learned-provider-declaration/0.1"},
        "provider_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1},
        "architecture_family": {"type": "string", "minLength": 1},
        "architecture_name": {"type": "string", "minLength": 1},
        "objective_family": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "training_objective": {"type": "string", "minLength": 1},
        "input_views": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_types": {"$ref": "#/$defs/nonEmptyStringArray"},
        "uncertainty_classes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "output_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/outputKind"}
        },
        "required_snapshot_types": {"$ref": "#/$defs/nonEmptyStringArray"},
        "advantages": {"$ref": "#/$defs/nonEmptyStringArray"},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "capacity": {"$ref": "#/$defs/capacity"},
        "cost": {"enum": ["low", "medium", "high"]},
        "cpu_appropriate": {"type": "boolean"},
        "calibration_required": {"const": true},
        "evaluator_eligible": {"const": false},
        "authority": {"const": "diagnostic-only"},
        "declaration_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_id",
        "provider_version",
        "declaration_identity",
        "model_identity",
        "feature_extractor_identity",
        "query_identity",
        "snapshot_ids",
        "output_kind",
        "value",
        "calibration_band",
        "out_of_distribution",
        "suggested_uncertainty_classes",
        "candidate_locations",
        "limitations",
        "authority",
        "verdict_semantics",
        "observation_identity"
      ],
      "properties": {
        "schema": {"const": "mnel-learned-provider-observation/0.1"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "declaration_identity": {"type": "string", "minLength": 1},
        "model_identity": {"type": "string", "minLength": 1},
        "feature_extractor_identity": {"type": "string", "minLength": 1},
        "query_identity": {"type": "string", "minLength": 1},
        "snapshot_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
        "output_kind": {"$ref": "#/$defs/outputKind"},
        "value": {"type": "number"},
        "calibration_band": {"type": "string", "minLength": 1},
        "out_of_distribution": {"type": "boolean"},
        "suggested_uncertainty_classes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "candidate_locations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority": {"const": "diagnostic-only"},
        "verdict_semantics": {"const": "not-a-verdict"},
        "observation_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty_classes"],
      "properties": {
        "uncertainty_classes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "available_snapshot_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_output_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/outputKind"}
        },
        "preferred_architecture_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_provider_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "max_cost": {"enum": ["low", "medium", "high"]}
      }
    }
  }
}
