{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnel.dev/schemas/mnel-fabric-config.schema.json",
  "title": "MNEL operator Fabric configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller_id", "workers"],
  "properties": {
    "controller_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state_path": {"type": "string", "minLength": 1},
    "pre_staged_bundle_identity": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"},
    "workers": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["worker_id", "host", "port", "capabilities", "ca_file", "client_cert", "client_key", "trust_store"],
        "properties": {
          "worker_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "host": {"type": "string", "minLength": 1, "maxLength": 253},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "capabilities": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
          "ca_file": {"type": "string", "minLength": 1},
          "client_cert": {"type": "string", "minLength": 1},
          "client_key": {"type": "string", "minLength": 1},
          "trust_store": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
