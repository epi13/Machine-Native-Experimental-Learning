{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/Machine-Native-Experimental-Learning/schemas/mnel-completion-provider-registry.schema.json",
  "title": "MNEL Completion Provider Registry",
  "description": "Architecture-neutral declarations for proposal-only code completion providers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": { "const": "mnel-completion-provider-registry/0.1" },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "operation": {
      "enum": [
        "inline-completion",
        "infill",
        "repair",
        "refactor",
        "proof-completion",
        "api-completion",
        "optimization",
        "control-flow-construction",
        "branch-mask-construction",
        "contract-satisfaction",
        "lowering"
      ]
    },
    "representation": {
      "enum": [
        "source-text",
        "ast",
        "typed-ast",
        "cfg",
        "ssa-use-def",
        "proof-state",
        "mncs-hir",
        "composite"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "version",
        "architecture_family",
        "objective_family",
        "supported_operations",
        "source_languages",
        "accepted_representations",
        "emitted_representations",
        "runtime_tier",
        "latency_class",
        "authority",
        "verdict_semantics",
        "limitations"
      ],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture_family": { "type": "string", "minLength": 1, "maxLength": 96 },
        "objective_family": { "type": "string", "minLength": 1, "maxLength": 96 },
        "supported_operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" },
          "uniqueItems": true
        },
        "source_languages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uniqueItems": true
        },
        "accepted_representations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/representation" },
          "uniqueItems": true
        },
        "emitted_representations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/representation" },
          "uniqueItems": true
        },
        "required_evidence_views": {
          "type": "array",
          "items": {
            "enum": [
              "types",
              "compiler-diagnostics",
              "proof-state",
              "static-analysis",
              "api-signatures",
              "execution-trace",
              "contracts",
              "verified-local-history"
            ]
          },
          "uniqueItems": true
        },
        "max_context_bytes": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "runtime_tier": {
          "enum": ["native-trusted", "wasm-quarantined", "external-experimental"]
        },
        "latency_class": { "enum": ["interactive", "near-interactive", "batch"] },
        "placement_compatibility": {
          "type": "array",
          "items": { "enum": ["cpu", "cuda", "sequential-cpu-offload"] },
          "uniqueItems": true
        },
        "weight_residency": { "enum": ["resident-on-admission", "experimental"] },
        "calibration_required": { "type": "boolean" },
        "abstention_supported": { "type": "boolean" },
        "architecture_rationale": { "type": "string", "maxLength": 2048 },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1024 }
        },
        "authority": { "const": "proposal-only" },
        "verdict_semantics": { "const": "not-a-verdict" }
      }
    }
  }
}
