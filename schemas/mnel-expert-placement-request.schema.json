{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnel.dev/schemas/mnel-expert-placement-request.schema.json",
  "title": "MNEL expert placement request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "placement_identity", "provider_id", "provider_artifact_identity", "model_identity", "calibration_identity", "architecture_family", "supported_snapshot_types", "model_size_bytes", "required_capabilities", "execution_device", "offload_policy", "authority", "semantics"],
  "properties": {
    "schema": {"const": "mnel-expert-placement-request/0.5"},
    "placement_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_artifact_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "model_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "calibration_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "architecture_family": {"type": "string", "minLength": 1},
    "supported_snapshot_types": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "model_size_bytes": {"type": "integer", "minimum": 1},
    "required_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "execution_device": {"enum": ["auto", "cpu", "cuda"]},
    "offload_policy": {"enum": ["auto", "none", "sequential-cpu"]},
    "minimum_ram_bytes": {"type": "integer", "minimum": 0},
    "maximum_vram_bytes": {"type": ["integer", "null"], "minimum": 1},
    "estimated_operations": {"type": "integer", "minimum": 0},
    "runtime_class": {"type": "string", "minLength": 1},
    "locality_hint": {"type": ["string", "null"]},
    "authority": {"const": "diagnostic-only"},
    "semantics": {"const": "worker capability request; not-a-verdict"}
  }
}
