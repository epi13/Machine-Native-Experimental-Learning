mncs 0.6;

// Shared boolean algebra over exhaustive matches. The source profiles define
// no boolean operators beyond their use as conditions.
module mnel.logic;

fn both(left: bool, right: bool) -> (result: bool) {
    if left {
        return right;
    }
    return false;
}

fn either(left: bool, right: bool) -> (result: bool) {
    if left {
        return true;
    }
    return right;
}

fn not(value: bool) -> (result: bool) {
    if value {
        return false;
    }
    return true;
}
