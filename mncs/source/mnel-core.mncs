mncs 0.5;

// MNEL core decision semantics reconstructed in MNCS.
//
// This module expresses the conceptual spine of Machine-Native Experimental
// Learning as language-native contracts rather than application code:
//
//   - the three-valued evidence lattice PASS / FAIL / UNKNOWN, in which
//     FAIL dominates, missing evidence yields UNKNOWN, and nothing here
//     can turn absence of evidence into success;
//   - hard-gate evaluation, where only an authorized evaluator derives a
//     verdict and every derived verdict carries its authorization effect;
//   - the experiment lifecycle state machine, including the budget-exceeded
//     path to REJECTED;
//   - the visibility ladder, which fails closed for future-final material;
//   - transfer-gated maturity: requested maturity collapses to PROVISIONAL
//     unless held-out transfer evidence supports it;
//   - plan validation, which rejects promotion authority, unknown governors,
//     forbidden visibility, and in-place candidate edits;
//   - negative memory, which demotes retrieval scores instead of deleting
//     lineage.
//
// Authority note: investigators and learned providers may propose knowledge.
// They may not declare it true. Nothing in this module accepts or promotes
// a proposal; it derives bounded observations and provisional states only.

module mnel.core;

enum Verdict { PASS, FAIL, UNKNOWN }

enum GateOperator { GE, GT, LE, LT, EQ }

enum MetricPresence { PRESENT, ABSENT }

enum ExperimentState {
    DRAFT,
    PREREGISTERED,
    RUNNING,
    OBSERVED,
    EVALUATED,
    ATTRIBUTED,
    DISTILLED_PROPOSAL,
    REJECTED,
    UNKNOWN,
}

enum LifecycleEvent {
    PREREGISTER,
    BEGIN_EXECUTION,
    BUDGET_WITHIN_LIMITS,
    BUDGET_EXCEEDED,
    EVALUATOR_VERDICT,
    RECORD_ATTRIBUTION,
    PROPOSE_DISTILLATION,
}

enum Visibility {
    DEVELOPMENT_VISIBLE,
    SELECTION_OBSERVED_NOT_REPAIRABLE,
    TRANSFER_HIDDEN,
    FUTURE_FINAL_INACCESSIBLE,
}

enum AccessPurpose { DEVELOPMENT_STUDY, TRANSFER_EVALUATOR }

enum TransferStatus { UNTESTED, FAILED, PARTIAL, SUPPORTED }

enum Maturity { PROVISIONAL, SUPPORTED, CHALLENGED, REJECTED, RETIRED }

enum RejectionReason {
    NONE,
    INVALID_TRANSITION,
    BUDGET_EXHAUSTED,
    AUTHORITY_EXPANSION,
    VISIBILITY_VIOLATION,
    IN_PLACE_EDIT,
}

enum ProbeRound { R1, R2, R3 }

record GateInput {
    present: MetricPresence,
    operator: GateOperator,
    observed: i64,
    threshold: i64,
}

record PlanFacts {
    governor_known: bool,
    promotion_authorized: bool,
    operations_budget: i64,
    most_hidden_rank_requested: i64,
    parent_matches_child: bool,
}

record TransitionOutcome {
    advanced: bool,
    next_state: ExperimentState,
    reason: RejectionReason,
}

record PlanDecision {
    accepted: bool,
    reason: RejectionReason,
}

record ProbeState {
    round: ProbeRound,
    presence: MetricPresence,
}

record ExperimentOutcome {
    final_state: ExperimentState,
    verdict: Verdict,
    principle_maturity: Maturity,
}

record ContextMembership {
    retrieval: bool,
    planning: bool,
    transfer: bool,
    monitoring: bool,
}

// Boolean helpers, expressed over exhaustive matches because the source
// profiles define no boolean operators beyond their use as conditions.
fn both(left: bool, right: bool) -> (result: bool) {
    if left {
        return right;
    }
    return false;
}

fn either(left: bool, right: bool) -> (result: bool) {
    if left {
        return true;
    }
    return right;
}

fn not(value: bool) -> (result: bool) {
    if value {
        return false;
    }
    return true;
}

fn presence_from(available: bool) -> (presence: MetricPresence) {
    if available {
        return MetricPresence.PRESENT;
    }
    return MetricPresence.ABSENT;
}

fn request_when_known(known: bool, requested: Maturity) -> (maturity: Maturity) {
    if known {
        return requested;
    }
    return Maturity.PROVISIONAL;
}

// The evidence lattice: FAIL dominates, UNKNOWN dominates PASS, PASS alone
// survives. Missing evidence (UNKNOWN) can therefore never be promoted to
// success by combination.
fn combine_verdict(left: Verdict, right: Verdict) -> (result: Verdict) {
    return match left {
        FAIL => Verdict.FAIL,
        UNKNOWN => match right {
            FAIL => Verdict.FAIL,
            PASS => Verdict.UNKNOWN,
            UNKNOWN => Verdict.UNKNOWN,
        },
        PASS => right,
    };
}

fn verdict_is_known(value: Verdict) -> (known: bool) {
    return match value {
        PASS => true,
        FAIL => true,
        UNKNOWN => false,
    };
}

// One hard gate compares one preregistered threshold against one observed
// metric. An absent metric is UNKNOWN, never a failure and never a success.
// Deriving a verdict is an effect that requires hard-gate authority.
fn evaluate_gate(input: GateInput) -> (verdict: Verdict)
    capability hard_gate_authority
    effect derive_verdict authorized_by hard_gate_authority
{
    let comparable: bool = match input.present {
        PRESENT => true,
        ABSENT => false,
    };
    if comparable {
        let holds: bool = match input.operator {
            GE => input.observed >= input.threshold,
            GT => input.observed > input.threshold,
            LE => input.observed <= input.threshold,
            LT => input.observed < input.threshold,
            EQ => input.observed == input.threshold,
        };
        if holds {
            return Verdict.PASS;
        }
        return Verdict.FAIL;
    }
    return Verdict.UNKNOWN;
}

// Aggregate four per-gate verdicts under MNEL's rule: any FAIL is FAIL,
// otherwise any UNKNOWN is UNKNOWN, otherwise PASS.
fn aggregate_four(
    first: Verdict,
    second: Verdict,
    third: Verdict,
    fourth: Verdict,
) -> (overall: Verdict) {
    let left_combined: Verdict = combine_verdict(first, second);
    let right_combined: Verdict = combine_verdict(third, fourth);
    return combine_verdict(left_combined, right_combined);
}

// Evaluate a fixed four-gate panel. Only this authority chain may derive
// the overall verdict for an experiment observation.
fn evaluate_gates(
    first: GateInput,
    second: GateInput,
    third: GateInput,
    fourth: GateInput,
) -> (overall: Verdict)
    capability hard_gate_authority
    effect derive_verdict authorized_by hard_gate_authority
{
    let first_verdict: Verdict = evaluate_gate(first);
    let second_verdict: Verdict = evaluate_gate(second);
    let third_verdict: Verdict = evaluate_gate(third);
    let fourth_verdict: Verdict = evaluate_gate(fourth);
    return aggregate_four(first_verdict, second_verdict, third_verdict, fourth_verdict);
}

// The visibility ladder ranks information exposure. Lower rank is more open.
fn visibility_rank(level: Visibility) -> (rank: i64) {
    return match level {
        DEVELOPMENT_VISIBLE => 0,
        SELECTION_OBSERVED_NOT_REPAIRABLE => 1,
        TRANSFER_HIDDEN => 2,
        FUTURE_FINAL_INACCESSIBLE => 3,
    };
}

// Fail-closed data access. Future-final material is inaccessible for every
// purpose; development studies may not read transfer-hidden material; the
// transfer evaluator sees transfer-hidden material and nothing more open.
fn access_granted(purpose: AccessPurpose, requested: Visibility) -> (granted: bool) {
    let requested_rank: i64 = visibility_rank(requested);
    let future_final: bool = requested_rank == 3;
    if future_final {
        return false;
    }
    return match purpose {
        DEVELOPMENT_STUDY => requested_rank <= 1,
        TRANSFER_EVALUATOR => requested_rank == 2,
    };
}

// Validate a preregistration plan against the governor's authority rules.
// Promotion authority can never be granted inside an experiment plan.
fn validate_plan(facts: PlanFacts) -> (decision: PlanDecision) {
    if facts.promotion_authorized {
        return PlanDecision {
            accepted: false,
            reason: RejectionReason.AUTHORITY_EXPANSION,
        };
    }
    if facts.parent_matches_child {
        return PlanDecision {
            accepted: false,
            reason: RejectionReason.IN_PLACE_EDIT,
        };
    }
    let visibility_open_enough: bool = facts.most_hidden_rank_requested <= 1;
    if visibility_open_enough {
        let governor_ok: bool = facts.governor_known;
        let budget_ok: bool = facts.operations_budget > 0;
        let admissible: bool = both(governor_ok, budget_ok);
        if admissible {
            return PlanDecision {
                accepted: true,
                reason: RejectionReason.NONE,
            };
        }
        let missing_budget: bool = not(budget_ok);
        if missing_budget {
            return PlanDecision {
                accepted: false,
                reason: RejectionReason.BUDGET_EXHAUSTED,
            };
        }
        return PlanDecision {
            accepted: false,
            reason: RejectionReason.AUTHORITY_EXPANSION,
        };
    }
    return PlanDecision {
        accepted: false,
        reason: RejectionReason.VISIBILITY_VIOLATION,
    };
}

// One lifecycle transition. Illegal transitions do not silently succeed:
// they return an explicit rejection that preserves the current state.
fn transition(current: ExperimentState, event: LifecycleEvent) -> (outcome: TransitionOutcome) {
    return match current {
        DRAFT => advance_or_reject(
            match event {
                PREREGISTER => true,
                BEGIN_EXECUTION => false,
                BUDGET_WITHIN_LIMITS => false,
                BUDGET_EXCEEDED => false,
                EVALUATOR_VERDICT => false,
                RECORD_ATTRIBUTION => false,
                PROPOSE_DISTILLATION => false,
            },
            current,
            ExperimentState.PREREGISTERED,
        ),
        PREREGISTERED => advance_or_reject(
            match event {
                PREREGISTER => false,
                BEGIN_EXECUTION => true,
                BUDGET_WITHIN_LIMITS => false,
                BUDGET_EXCEEDED => false,
                EVALUATOR_VERDICT => false,
                RECORD_ATTRIBUTION => false,
                PROPOSE_DISTILLATION => false,
            },
            current,
            ExperimentState.RUNNING,
        ),
        RUNNING => match event {
            BUDGET_WITHIN_LIMITS => TransitionOutcome {
                advanced: true,
                next_state: ExperimentState.OBSERVED,
                reason: RejectionReason.NONE,
            },
            BUDGET_EXCEEDED => TransitionOutcome {
                advanced: true,
                next_state: ExperimentState.REJECTED,
                reason: RejectionReason.BUDGET_EXHAUSTED,
            },
            PREREGISTER => rejected_transition(current),
            BEGIN_EXECUTION => rejected_transition(current),
            EVALUATOR_VERDICT => rejected_transition(current),
            RECORD_ATTRIBUTION => rejected_transition(current),
            PROPOSE_DISTILLATION => rejected_transition(current),
        },
        OBSERVED => advance_or_reject(
            match event {
                PREREGISTER => false,
                BEGIN_EXECUTION => false,
                BUDGET_WITHIN_LIMITS => false,
                BUDGET_EXCEEDED => false,
                EVALUATOR_VERDICT => true,
                RECORD_ATTRIBUTION => false,
                PROPOSE_DISTILLATION => false,
            },
            current,
            ExperimentState.EVALUATED,
        ),
        EVALUATED => advance_or_reject(
            match event {
                PREREGISTER => false,
                BEGIN_EXECUTION => false,
                BUDGET_WITHIN_LIMITS => false,
                BUDGET_EXCEEDED => false,
                EVALUATOR_VERDICT => false,
                RECORD_ATTRIBUTION => true,
                PROPOSE_DISTILLATION => false,
            },
            current,
            ExperimentState.ATTRIBUTED,
        ),
        ATTRIBUTED => advance_or_reject(
            match event {
                PREREGISTER => false,
                BEGIN_EXECUTION => false,
                BUDGET_WITHIN_LIMITS => false,
                BUDGET_EXCEEDED => false,
                EVALUATOR_VERDICT => false,
                RECORD_ATTRIBUTION => false,
                PROPOSE_DISTILLATION => true,
            },
            current,
            ExperimentState.DISTILLED_PROPOSAL,
        ),
        DISTILLED_PROPOSAL => rejected_transition(current),
        REJECTED => rejected_transition(current),
        UNKNOWN => rejected_transition(current),
    };
}

fn advance_or_reject(
    event_applies: bool,
    current: ExperimentState,
    following: ExperimentState,
) -> (outcome: TransitionOutcome) {
    if event_applies {
        return TransitionOutcome {
            advanced: true,
            next_state: following,
            reason: RejectionReason.NONE,
        };
    }
    return rejected_transition(current);
}

fn rejected_transition(current: ExperimentState) -> (outcome: TransitionOutcome) {
    return TransitionOutcome {
        advanced: false,
        next_state: current,
        reason: RejectionReason.INVALID_TRANSITION,
    };
}

// Transfer-gated maturity: requested SUPPORTED status survives only when
// held-out transfer actually supports the proposal; every other transfer
// state demotes the request to PROVISIONAL.
fn effective_maturity(requested: Maturity, transfer: TransferStatus) -> (maturity: Maturity) {
    let supported_transfer: bool = match transfer {
        UNTESTED => false,
        FAILED => false,
        PARTIAL => false,
        SUPPORTED => true,
    };
    if supported_transfer {
        return requested;
    }
    return match requested {
        PROVISIONAL => Maturity.PROVISIONAL,
        SUPPORTED => Maturity.PROVISIONAL,
        CHALLENGED => Maturity.CHALLENGED,
        REJECTED => Maturity.REJECTED,
        RETIRED => Maturity.RETIRED,
    };
}

// Negative memory conflicts over a bounded set of named learning contexts.
// A hit demotes retrieval scoring; it never deletes positive lineage.
fn negative_memory_conflicts(rule: ContextMembership, context: ContextMembership) -> (hit: bool) {
    let retrieval_hit: bool = both(rule.retrieval, context.retrieval);
    let planning_hit: bool = both(rule.planning, context.planning);
    let transfer_hit: bool = both(rule.transfer, context.transfer);
    let monitoring_hit: bool = both(rule.monitoring, context.monitoring);
    let first_pair: bool = either(retrieval_hit, planning_hit);
    let second_pair: bool = either(transfer_hit, monitoring_hit);
    return either(first_pair, second_pair);
}

// Retrieval demotion: a conflicting negative memory subtracts six points
// from the candidate score, matching the reference study weights.
fn retrieval_score(base: i64, rule: ContextMembership, context: ContextMembership) -> (score: i64) {
    let conflicted: bool = negative_memory_conflicts(rule, context);
    if conflicted {
        return base - 6;
    }
    return base;
}

// Bounded probe: retry an unavailable metric across at most three rounds,
// returning as soon as the metric is present. Exhausting the bound leaves
// the result ABSENT, which downstream evaluation reports as UNKNOWN.
fn probe_metric_availability(
    round_one: bool,
    round_two: bool,
    round_three: bool,
) -> (presence: MetricPresence)
    capability forge_probe_authority
    effect observe authorized_by forge_probe_authority
{
    iterate probes up_to 3 carrying state: ProbeState = ProbeState {
        round: ProbeRound.R1,
        presence: MetricPresence.ABSENT,
    } {
        let available_now: bool = match state.round {
            R1 => round_one,
            R2 => round_two,
            R3 => round_three,
        };
        let seen: MetricPresence = presence_from(available_now);
        let resolved: bool = match seen {
            PRESENT => true,
            ABSENT => false,
        };
        if resolved {
            return seen;
        }
        let next_round: ProbeRound = match state.round {
            R1 => ProbeRound.R2,
            R2 => ProbeRound.R3,
            R3 => ProbeRound.R3,
        };
        next state = ProbeState {
            round: next_round,
            presence: seen,
        };
    }
    return state.presence;
}

// The reference experiment spine, mirroring MNEL's deterministic demo run:
// a validated plan advances through the lifecycle, the authorized evaluator
// derives the overall verdict from four preregistered gates, attribution is
// recorded, and a distillation proposal carries transfer-gated maturity.
// An experiment whose verdict is UNKNOWN can still reach DISTILLED_PROPOSAL,
// but its principle remains PROVISIONAL: unknown results propose nothing.
fn run_reference_experiment(
    plan: PlanFacts,
    first: GateInput,
    second: GateInput,
    third: GateInput,
    fourth: GateInput,
    transfer: TransferStatus,
    requested_maturity: Maturity,
) -> (outcome: ExperimentOutcome)
    capability hard_gate_authority
    effect derive_verdict authorized_by hard_gate_authority
{
    let admission: PlanDecision = validate_plan(plan);
    let admitted: bool = admission.accepted;
    if admitted {
        let preregistration: TransitionOutcome =
            transition(ExperimentState.DRAFT, LifecycleEvent.PREREGISTER);
        let execution_start: TransitionOutcome = transition(
            preregistration.next_state,
            LifecycleEvent.BEGIN_EXECUTION,
        );
        let observation: TransitionOutcome = transition(
            execution_start.next_state,
            LifecycleEvent.BUDGET_WITHIN_LIMITS,
        );
        let overall: Verdict = evaluate_gates(first, second, third, fourth);
        let evaluated: TransitionOutcome = transition(
            observation.next_state,
            LifecycleEvent.EVALUATOR_VERDICT,
        );
        let attributed: TransitionOutcome = transition(
            evaluated.next_state,
            LifecycleEvent.RECORD_ATTRIBUTION,
        );
        let distilled: TransitionOutcome = transition(
            attributed.next_state,
            LifecycleEvent.PROPOSE_DISTILLATION,
        );
        let known_verdict: bool = verdict_is_known(overall);
        let gated_request: Maturity = request_when_known(known_verdict, requested_maturity);
        let maturity: Maturity = effective_maturity(gated_request, transfer);
        return ExperimentOutcome {
            final_state: distilled.next_state,
            verdict: overall,
            principle_maturity: maturity,
        };
    }
    return ExperimentOutcome {
        final_state: ExperimentState.REJECTED,
        verdict: Verdict.UNKNOWN,
        principle_maturity: Maturity.PROVISIONAL,
    };
}
